# Meta Model API (https://dev.meta.ai/docs/overview)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Local app config
NEXT_PUBLIC_APP_NAME=ExplainCut
# Public origin used for canonical URLs, share images, robots.txt and sitemap.xml
# (no trailing slash). Defaults to http://localhost:3000, or the Vercel
# production URL when deployed there.
NEXT_PUBLIC_SITE_URL=
JOB_DATA_DIR=./data/jobs

# Parallel SAM 3.1 calls during speaker segmentation (default 6). Lower it if
# the API starts rate-limiting; failed frames retry, then fall back to an ellipse.
SAM_CONCURRENCY=6

# Muse Spark fix drafts per self-review (default 1). Higher values ask Spark to
# redraft while serious timing/overlap problems remain - each adds ~1-2 min.
SPARK_FIX_DRAFTS=1

# Timeout per Meta API call in ms (default 240000). A stalled call fails and the
# pipeline falls back instead of hanging.
META_TIMEOUT_MS=240000
