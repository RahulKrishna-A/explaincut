# Meta Model API (https://dev.meta.ai/docs/overview)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Local app config
NEXT_PUBLIC_APP_NAME=ExplainCut
JOB_DATA_DIR=./data/jobs

# Parallel SAM 3.1 calls during speaker segmentation (default 6). Lower it if
# the API starts rate-limiting; failed frames retry, then fall back to an ellipse.
SAM_CONCURRENCY=6
